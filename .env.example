# ── Paystack ─────────────────────────────────────────────────────────────
# Get your keys at https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Test mode keys start with sk_test_ / pk_test_ (use Paystack test cards for free testing)
# Live mode keys start with sk_live_ / pk_live_ (switch on in Paystack dashboard)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Without these keys the app runs in PAYSTACK DEMO MODE:
# the card checkout simulates a successful payment and is clearly labelled as a demo.
